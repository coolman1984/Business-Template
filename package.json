{
  "name": "business-systems-factory",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "local": "tsx scripts/local.ts",
    "typecheck": "tsc -p tsconfig.json && tsc -p apps/business-web/tsconfig.json",
    "test": "vitest run",
    "test:demo": "node --test examples/ceramics-demo/data.test.mjs",
    "test:demo-ui": "node examples/ceramics-demo/qa-sweep.mjs",
    "db:bootstrap": "tsx scripts/bootstrap.ts",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed-demo": "tsx scripts/seed-demo.ts",
    "generate:client": "tsx scripts/generate-client.ts",
    "start": "tsx apps/api/src/main.ts",
    "build:web": "vite build apps/business-web",
    "dev:web": "vite apps/business-web",
    "worker": "tsx apps/api/src/worker.ts",
    "audit:archive": "tsx scripts/audit-archive.ts",
    "audit:verify": "tsx scripts/audit-archive.ts --verify",
    "backup": "tsx scripts/backup.ts",
    "restore": "tsx scripts/restore.ts"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "embedded-postgres": "16.14.0-beta.17",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vite": "^8.3.1",
    "vitest": "^5.0.1"
  },
  "dependencies": {
    "@fastify/static": "^10.1.4",
    "@fontsource/instrument-serif": "5.3.0",
    "@fontsource/inter": "5.3.0",
    "@fontsource/noto-naskh-arabic": "5.3.0",
    "@fontsource/noto-sans-arabic": "5.3.0",
    "ajv": "^8.20.0",
    "better-auth": "1.7.6",
    "fastify": "^5.12.5",
    "kysely": "^0.29.6",
    "pg": "^8.23.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  }
}
