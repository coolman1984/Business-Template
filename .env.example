# Copy to .env and change every password. Never commit .env.

# --- compose.yaml (on-premise machine) ---
POSTGRES_SUPERUSER_PASSWORD=change-me-superuser
OWNER_PASSWORD=change-me-owner
APP_PASSWORD=change-me-app
# 127.0.0.1 = this machine only; set to the machine's LAN address to serve the office network.
LISTEN_ADDRESS=127.0.0.1

# --- running without containers ---
DATABASE_ADMIN_URL=postgres://postgres@127.0.0.1:5432/postgres
DATABASE_OWNER_URL=postgres://factory_owner:change-me-owner@127.0.0.1:5432/factory
DATABASE_APP_URL=postgres://factory_app:change-me-app@127.0.0.1:5432/factory
